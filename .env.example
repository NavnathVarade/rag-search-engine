# Copy to .env and adjust. See docs/configuration.md for the full list.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

BM25_K1=1.5
BM25_B=0.75

ANN_BACKEND=brute_force
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64

DENSE_TOP_K=50
SPARSE_TOP_K=50
RRF_K=60
DEFAULT_RETRIEVAL_MODE=hybrid

RERANKER_ENABLED=true
RERANK_TOP_K=5

MAX_CONTEXT_TOKENS=6000

CHUNKING_STRATEGY=recursive
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

MAX_DOCUMENT_SIZE_MB=25
MAX_PDF_PAGES=500
MAX_QUERY_LENGTH=2000

AUTH_ENABLED=false
RATE_LIMIT_ANONYMOUS_PER_MIN=30
RATE_LIMIT_AUTHENTICATED_PER_MIN=120

METRICS_ENABLED=true
OTEL_ENDPOINT=

# Where documents live: none (memory, optional STATE_FILE snapshot) | postgres (DATABASE_URL; run `alembic upgrade head`)
STORE_BACKEND=none
# JSON snapshot of the API index when STORE_BACKEND=none (empty = memory only)
STATE_FILE=

# Evidence gate for chat (embedder-specific; 0 disables). See docs/context-selection.md
MIN_DENSE_SIMILARITY=0.2
# BM25 stemming: none | light | porter
BM25_STEMMER=porter

# --- web UI and extra endpoints ---
# The API serves the built React app (frontend/dist) at / when that folder exists.
FRONTEND_DIR=frontend/dist
# Folder of benchmark JSON files (written by scripts/run_beir.py) shown on the Analytics page.
BENCHMARKS_DIR=benchmarks/results
# POST /api/v1/documents/ingest-url refuses private/loopback addresses (SSRF protection). Operator override; keep false in production.
URL_INGEST_ALLOW_PRIVATE=false
